              "formdata": [
                {
                  "key": "title",
                  "value": "Diwali Special Banner",
                  "type": "text"
                },
                {
                  "key": "bannerimage",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/banner/add",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "banner",
                "add"
              ]
